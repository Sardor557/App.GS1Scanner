<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="App.GS1Scanner.MainPage">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry x:Name="loginEntry" Placeholder="Login" />
        <Entry x:Name="passwordEntry" Placeholder="Password" IsPassword="True" />
        <Button x:Name="loginButton" Text="Войти" Clicked="OnLoginClicked" />

        <Button x:Name="scanButton" Text="Сканировать код" Clicked="OnScanClicked" />
        <Button x:Name="logoutButton" Text="Выход" Clicked="OnLogoutClicked" />

        <Label x:Name="resultLabel" TextColor="DarkGreen" />
    </VerticalStackLayout>
</ContentPage>

{
  "Server": {
    "Url": "http://192.168.0.200:22480"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "flushToDiskInterval": 1,
          "rollingInterval": "Day"
        }
      }
    ]
  }
}